require("dotenv").config();
const express=require("express"),cors=require("cors"),jwt=require("jsonwebtoken"),bcrypt=require("bcryptjs"),{Pool}=require("pg");
const app=express(); app.use(cors()); app.use(express.json());
const pool=new Pool({connectionString:process.env.DATABASE_URL||"postgresql://postgres:postgres@localhost:5432/factory_monitoring"});
const machines=[
["CNC-01","CNC","Running",248,18,42],["CNC-02","CNC","Running",231,24,45],["VMC-01","VMC","Idle",196,37,51],["Lathe-01","Lathe","Running",312,12,31],
["Press-01","Press","Stopped",154,68,62],["Welding-01","Welding","Running",289,21,38],["Injection-01","Injection","Alarm",173,55,73],["Compressor-01","Compressor","Running",0,9,0]
];
async function init(){
 const r=await pool.query("SELECT count(*) FROM users"); if(+r.rows[0].count===0) await pool.query("INSERT INTO users(email,password_hash,role) VALUES($1,$2,'owner')",["owner@demo.com",await bcrypt.hash("demo123",10)]);
}
function auth(req,res,next){try{req.user=jwt.verify((req.headers.authorization||"").replace("Bearer ",""),process.env.JWT_SECRET||"demo-secret");next()}catch{res.status(401).json({error:"Unauthorized"})}}
app.get("/api/health",(req,res)=>res.json({ok:true}));
app.post("/api/auth/login",async(req,res)=>{let {email,password}=req.body;let u=(await pool.query("SELECT * FROM users WHERE email=$1",[email])).rows[0];if(!u||!(await bcrypt.compare(password,u.password_hash)))return res.status(401).json({error:"Invalid credentials"});res.json({token:jwt.sign({id:u.id,email:u.email,role:u.role},process.env.JWT_SECRET||"demo-secret",{expiresIn:"1d"}),user:{email:u.email,role:u.role}})});
app.get("/api/dashboard",auth,async(req,res)=>{let m=(await pool.query("SELECT * FROM machines ORDER BY id")).rows;let alerts=(await pool.query("SELECT a.*,m.machine_code FROM alerts a JOIN machines m ON m.id=a.machine_id WHERE a.resolved=false ORDER BY a.created_at DESC LIMIT 10")).rows;res.json({machines:m,alerts,kpis:{total:m.length,running:m.filter(x=>x.status==="Running").length,production:m.reduce((s,x)=>s+x.production,0),activeAlerts:alerts.length}})});
app.get("/api/machines",auth,async(req,res)=>res.json((await pool.query("SELECT * FROM machines ORDER BY id")).rows));
app.get("/api/machines/:id",auth,async(req,res)=>{let r=await pool.query("SELECT * FROM machines WHERE id=$1",[req.params.id]);r.rows[0]?res.json(r.rows[0]):res.status(404).json({error:"Not found"})});
app.get("/api/subscription",auth,async(req,res)=>res.json((await pool.query("SELECT * FROM subscriptions WHERE factory_id=1 LIMIT 1")).rows[0]||null));
app.post("/api/subscription",auth,async(req,res)=>{let {plan}=req.body;let limits={Starter:10,Business:50,Enterprise:99999};let r=await pool.query("UPDATE subscriptions SET plan=$1,machine_limit=$2,status='active' WHERE factory_id=1 RETURNING *",[plan,limits[plan]||50]);res.json(r.rows[0])});
async function simulate(){try{for(let m of (await pool.query("SELECT * FROM machines")).rows){let status=m.status;if(Math.random()<.06)status=["Running","Idle","Stopped"][Math.floor(Math.random()*3)];let prod=m.production+(status==="Running"?Math.floor(Math.random()*3):0);let down=m.downtime_minutes+(Math.random()<.03?1:0);await pool.query("UPDATE machines SET status=$1,production=$2,downtime_minutes=$3,updated_at=NOW() WHERE id=$4",[status,prod,down,m.id]);if(Math.random()<.015){await pool.query("INSERT INTO alerts(machine_id,level,message) VALUES($1,'High','Machine alarm detected')",[m.id]);}}}catch(e){console.error("Simulator:",e.message)}}
init().then(()=>{app.listen(process.env.PORT||5000,()=>console.log("API http://localhost:"+(process.env.PORT||5000)));setInterval(simulate,3000)}).catch(console.error);
